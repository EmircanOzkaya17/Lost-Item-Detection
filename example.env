# =====================================================================
# UNUTULAN ESYA TESPIT SISTEMI - YAPILANDIRMA DOSYASI
# ---------------------------------------------------------------------
# Bu dosya sistemin tum yapilandirma parametrelerini icerir.
# Kod icerisinde hicbir sabit deger (magic number) kullanilmamalidir.
#
# NOT: Asagidaki bolumler Sistem Mimarisi - 1 kapsamindadir.
#      Tracker / ReID / Association Memory parametreleri sonraki
#      adimlarda bu dosyaya eklenecektir.
# =====================================================================


# ---------------------------------------------------------------------
# MODEL AYARLARI
# ---------------------------------------------------------------------

# YOLO model agirlik dosyasinin yolu (varsayilan COCO agirliklari).
# Egitim yapilmayacaktir, hazir agirlar kullanilir.
MODEL_PATH=yolo11m.pt

# Kullanilacak cihaz. USE_GPU=true ve CUDA mevcutsa bu deger kullanilir,
# aksi halde otomatik olarak cpu'ya dusulur.
# Ornek degerler: cuda:0 | cuda | cpu
MODEL_DEVICE=cuda:0

# GPU (ekran karti) kullanilsin mi? (YOLO ve OSNet icin ortak)
USE_GPU=true

# FP16 (half precision) cikarim. Yalnizca CUDA uzerinde gecerlidir;
# CPU'ya dusulmesi durumunda otomatik olarak devre disi birakilir.
USE_FP16=true

# Model giris cozunurlugu
MODEL_IMGSZ=1280

# --- Tespit guven esikleri (sinif bazli) ---
#
# Kisi tespiti kolaydir ve yuksek skor uretir. Yere birakilmis, kendi uzerine
# cokmus, tepeden aciyla goruntulenen, golgede kalan bir canta ise COCO'daki
# "backpack" dagiliminin (sirtta tasinan, dik siluetli, askilari gorunur)
# disinda kalir ve skoru dramatik olarak duser. Tek bir esik kullanmak, esya
# duyarliligini kisi tespitinin gerektirdigi siki esige mahkum eder.
#
# Cikarim (inference) bu iki degerin EN DUSUGU ile yapilir; eleme NMS
# sonrasinda sinif bazli olarak detector.py icinde uygulanir.

# Kisi sinifi icin guven esigi
CONF_THRESHOLD=0.25

# Esya siniflari (backpack, handbag, laptop, cell phone) icin guven esigi.
ITEM_CONF_THRESHOLD=0.10

# NMS IoU esigi
IOU_THRESHOLD=0.7

# Tek bir frame'de dondurulecek maksimum tespit sayisi
MAX_DET=300

# Ultralytics'in konsol ciktisi
MODEL_VERBOSE=false


# ---------------------------------------------------------------------
# TESPIT EDILECEK SINIFLAR
# ---------------------------------------------------------------------
TARGET_CLASSES=person,backpack,handbag,suitcase,cell phone,laptop
# Esya siniflari arasinda ust uste binen kutulardan yalnizca en gucluyu tut.
ITEM_CROSS_CLASS_NMS=true


# ---------------------------------------------------------------------
# GORUNTU ON ISLEME (PREPROCESSING)
# ---------------------------------------------------------------------
# --- CLAHE (Contrast Limited Adaptive Histogram Equalization) ---
CLAHE_ENABLED=true
CLAHE_CLIP_LIMIT=2.0
CLAHE_TILE_GRID_SIZE=8,8

# --- Gamma duzeltmesi ---
GAMMA_ENABLED=true
GAMMA=1.2


# ---------------------------------------------------------------------
# TRACKER AYARLARI (BoT-SORT)
# ---------------------------------------------------------------------
TRACKER_TYPE=botsort

# Birinci eslestirme turunun guven esigi (yuksek guvenli tespitler).
TRACK_HIGH_THRESH=0.30

# Ikinci eslestirme turunun alt siniri.
TRACK_LOW_THRESH=0.05

# Yeni bir Track olusturma esigi.
NEW_TRACK_THRESH=0.35

# IoU eslestirme esigi.
MATCH_THRESH=0.85

# Nesne kaybolduktan sonra ID'sinin bellekte tutulacagi sure (frame).
TRACK_BUFFER=90

# Videonun FPS degeri.
TRACKER_FPS=30

# Tespit guveni ile eslestirme skorunun birlestirilmesi
FUSE_SCORE=true

# --- BoT-SORT dahili ReID ---
TRACKER_WITH_REID=false
TRACKER_REID_MODEL=auto
PROXIMITY_THRESH=0.5
APPEARANCE_THRESH=0.25

# --- Global Motion Compensation (GMC) ---
GMC_METHOD=sparseOptFlow


# ---------------------------------------------------------------------
# IDENTITY LAYER - 1) ReID (OSNet)
# ---------------------------------------------------------------------
# Agirlik dosyasini python install.py otomatik indirir.
OSNET_MODEL_PATH=models/osnet_x1_0_msmt17.pt
# osnet_x1_0 | osnet_x0_75 | osnet_x0_5 | osnet_x0_25 | osnet_ibn_x1_0
OSNET_ARCH=osnet_x1_0
# auto | builtin | torchreid | torchscript   (builtin: src/osnet.py)
REID_BACKEND=auto
REID_DEVICE=cuda:0
REID_USE_FP16=true
REID_INPUT_HEIGHT=256
REID_INPUT_WIDTH=128
EMBEDDING_SIZE=512
REID_BATCH_SIZE=16
REID_MIN_CROP_HEIGHT=48

REID_THRESHOLD=0.65
NEW_PERSON_THRESHOLD=0.45
REID_MATCH_STRATEGY=max
REID_INTERVAL=15


# ---------------------------------------------------------------------
# IDENTITY LAYER - 2) ASSOCIATION MEMORY
# ---------------------------------------------------------------------
MAX_EMBEDDING_HISTORY=5
PERSON_MEMORY_SIZE=500
MAX_TRACK_LOST_TIME=30
MEMORY_TIMEOUT=300
MEMORY_PURGE_ENABLED=false

# Mesafeler yaklasik METREDIR: kenar boslugu / kisi kutu yuksekligi x PERSON_HEIGHT_M
PERSON_HEIGHT_M=1.7

# Sahiplik: yakindaki kisiler zamanla kanit biriktirir. Lider kanit
# >= OWNERSHIP_CONFIRM_TIME ve ikincinin OWNERSHIP_DOMINANCE kati olunca atanir.
OWNERSHIP_DISTANCE_M=0.6
OWNERSHIP_CONFIRM_TIME=1.0
OWNERSHIP_MEMORY_TIME=5.0
OWNERSHIP_DOMINANCE=2.0

ITEM_REMATCH_DISTANCE=60
ITEM_REMATCH_TIMEOUT=120
ITEM_REMATCH_SEEN_GAP=0.5
# Yeniden eslesmede eski/yeni kutu alanlarinin en buyuk orani.
ITEM_REMATCH_MAX_AREA_RATIO=2.0

UUID_PREFIX_PERSON=P
UUID_PREFIX_BACKPACK=B
UUID_PREFIX_HANDBAG=H
UUID_PREFIX_SUITCASE=S
UUID_PREFIX_LAPTOP=L
UUID_PREFIX_CELL_PHONE=C
UUID_PREFIX_DEFAULT=X
UUID_PAD_WIDTH=3


# ---------------------------------------------------------------------
# UNUTULAN ESYA AYARLARI
# ---------------------------------------------------------------------
# Mesafeler yaklasik metre (PETS 2006: 2 m uyari, 3 m alarm).
# Sureler kisa demo videolari icindir; gercek kurulumda 10 / 30 sn onerilir.
FORGET_DISTANCE_M=2.0
FORGET_TIME=1.0
ABANDONED_DISTANCE_M=3.0
ABANDONED_TIME=2.0
# Esyanin bu orani herhangi bir kisinin kutusundaysa sayac duraklatilir.
ATTENDED_OVERLAP=0.5
# Son ITEM_MOTION_WINDOW sn'de kosegeninin ITEM_MOTION_TOLERANCE katindan
# fazla yer degistiren esya tasiniyor sayilir (sayac sifirlanir).
ITEM_MOTION_WINDOW=1.0
ITEM_MOTION_TOLERANCE=1.0
# Esya/sahip bu sureden kisa gorunmezse sayac ilerlemez, durum korunur.
OCCLUSION_HOLD_TIME=1.0
# Goruntu kenarina bu oranda yakin kaybolan kisi kadrajdan cikmis sayilir.
EXIT_BORDER_MARGIN=0.02
# Kaybolurken bu hizdan (m/s) hizli uzaklasan sahip icin bekleme yapilmaz.
OWNER_LEAVING_SPEED=0.5


# ---------------------------------------------------------------------
# GORSELLESTIRME AYARLARI
# ---------------------------------------------------------------------
SHOW_FPS=true
SHOW_TRACK_ID=true
SHOW_UUID=true
SHOW_ASSOCIATION_LINE=true
SHOW_WARNING_TEXT=true
SHOW_HUD=true
SHOW_OWNER=true
SHOW_CONFIDENCE=false

VIZ_LINE_THICKNESS=2
VIZ_FONT_SCALE=0.5
VIZ_AUTO_SCALE=true
VIZ_REFERENCE_HEIGHT=1080
VIZ_CORNER_STYLE=true
VIZ_CORNER_RATIO=0.22
VIZ_PANEL_ALPHA=0.55
VIZ_ASSOCIATION_THICKNESS=1
VIZ_MAX_WARNINGS=3


# ---------------------------------------------------------------------
# BOUNDING BOX RENKLERI (BGR formatinda)
# ---------------------------------------------------------------------
PERSON_COLOR=0,255,0
BACKPACK_COLOR=255,0,0
HANDBAG_COLOR=255,0,255
SUITCASE_COLOR=255,255,0
LAPTOP_COLOR=0,165,255
CELL_PHONE_COLOR=0,255,255
DEFAULT_COLOR=200,200,200

TEXT_COLOR=255,255,255
PANEL_COLOR=0,0,0
WARNING_COLOR=0,0,255
ASSOCIATION_LINE_COLOR=180,180,180


# ---------------------------------------------------------------------
# LOGLAMA AYARLARI
# ---------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_TO_FILE=false
LOG_FILE=results/system.log


# ---------------------------------------------------------------------
# VIDEO AYARLARI
# ---------------------------------------------------------------------
VIDEO_PATH=assets/source-8.mp4
OUTPUT_PATH=results/output.mp4
SAVE_OUTPUT=true
SHOW_WINDOW=true
